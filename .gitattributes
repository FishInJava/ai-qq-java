# ============================================================
# ai-qq-java / .gitattributes
# 换行符统一策略：仓库（index）内一律 LF，检出行为由本文件固定，
# 不依赖各人机器上的 core.autocrlf 设置。
#   - 源码/配置/文档：检出为 LF，Windows / Linux / macOS 表现一致
#   - Windows 原生脚本：检出为 CRLF，避免 cmd.exe 解析异常
# ============================================================

# 默认：自动识别文本，统一按 LF 存储与检出
* text=auto eol=lf

# ---- 源码 / 配置 / 文档：显式声明为文本，LF ----
*.java         text eol=lf
*.kt           text eol=lf
*.groovy       text eol=lf
*.xml          text eol=lf
*.properties   text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.json         text eol=lf
*.md           text eol=lf
*.txt          text eol=lf
*.ts           text eol=lf
*.sql          text eol=lf
*.config       text eol=lf
*.factories    text eol=lf
*.sh           text eol=lf
mvnw           text eol=lf

# ---- Windows 原生脚本：CRLF ----
*.bat          text eol=crlf
*.cmd          text eol=crlf
mvnw.cmd       text eol=crlf
*.ps1          text eol=crlf
*.psm1         text eol=crlf
*.psd1         text eol=crlf

# ---- 二进制文件：不做换行符转换，也不做 diff ----
*.class        binary
*.jar          binary
*.war          binary
*.ear          binary
*.zip          binary
*.gz           binary
*.tar          binary
*.7z           binary
*.hprof        binary
*.jks          binary
*.p12          binary
*.keystore     binary
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.ico          binary
*.svg          text eol=lf
*.pdf          binary
*.woff         binary
*.woff2        binary
*.ttf          binary
