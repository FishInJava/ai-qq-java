# ============================================================
# ai-qq-java / .gitignore
# Spring Boot 4 + Java 21 + Maven 多模块（源码根：server/）
# 规则按类别分组，新增条目请放进对应分组
# ============================================================

### Java 编译与打包产物
*.class
*.jar
# Maven Wrapper 的 jar 需要入库，故排除上面的 *.jar
!.mvn/wrapper/maven-wrapper.jar
*.war
*.nar
*.ear
*.ctxt
.mtj.tmp/

# JVM 崩溃 / 堆转储（含 OOM dump）
hs_err_pid*
replay_pid*
*.hprof

### Maven 构建
# 所有模块的 target（含 classes、surefire-reports、site/jacoco 覆盖率报告）
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
.flattened-pom.xml
buildNumber.properties
.mvn/timing.properties

### 运行日志
# 注意：log/ 只匹配目录，不会误伤 logback-spring.xml
*.log
*.log.gz
log/
logs/

### 本地环境与凭据
# 数据源等配置走环境变量，本地覆盖文件不入库
.env
.env.*
!.env.example
application-local.yml
application-local.yaml
application-local.properties
application-local-*.yml
application-local-*.yaml
application-local-*.properties
*.jks
*.p12
*.keystore

### IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/

### Eclipse / STS
.settings/
.project
.classpath
.factorypath
.apt_generated/
.sts4-cache/
bin/

### VS Code
.vscode/

### 操作系统
.DS_Store
Thumbs.db
desktop.ini

### 本地工具缓存（.agents/skills 属于项目资产，需入库）
.codegraph/
node_modules/
temp/*.*

### 临时文件
*.tmp
*.bak
*.orig
